{
  "$description": "bright-primaries: four bright primaries (blue, red, yellow, green) on plain white, near-black ink, grey secondary text and light-grey surfaces. Crisp and high-key; the brights are fills and strokes, darker shades carry accent text.",
  "$extensions": {
    "com.twm.palette": {
      "pairs": [
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.paper}",
          "use": "text",
          "$description": "titles and body on the page"
        },
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.paper-deep}",
          "use": "text",
          "$description": "text on quiet fills and pills"
        },
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.tile}",
          "use": "text",
          "$description": "tile titles and card text"
        },
        {
          "fg": "{sys.color.ink-2}",
          "bg": "{sys.color.paper}",
          "use": "text",
          "$description": "secondary text on the page"
        },
        {
          "fg": "{sys.color.ink-2}",
          "bg": "{sys.color.paper-deep}",
          "use": "text",
          "$description": "secondary text on quiet fills"
        },
        {
          "fg": "{sys.color.ink-2}",
          "bg": "{sys.color.tile}",
          "use": "text",
          "$description": "tile subtitles"
        },
        {
          "fg": "{sys.color.accent-ink}",
          "bg": "{sys.color.paper}",
          "use": "text",
          "$description": "kickers and links on the page"
        },
        {
          "fg": "{sys.color.accent-ink}",
          "bg": "{sys.color.paper-deep}",
          "use": "text",
          "$description": "current chapter on a quiet pill"
        },
        {
          "fg": "{sys.color.accent-ink}",
          "bg": "{sys.color.tile}",
          "use": "text",
          "$description": "tags and the current chapter on a tile"
        },
        {
          "fg": "{sys.color.loss}",
          "bg": "{sys.color.paper}",
          "use": "text",
          "$description": "loss figures and labels"
        },
        {
          "fg": "{sys.color.loss}",
          "bg": "{sys.color.tile}",
          "use": "text",
          "$description": "loss tags and annotation leads on tiles"
        },
        {
          "fg": "{sys.color.loss}",
          "bg": "{sys.color.paper-deep}",
          "use": "text",
          "$description": "loss labels on quiet fills"
        },
        {
          "fg": "{sys.color.paper}",
          "bg": "{sys.color.ink}",
          "use": "text",
          "$description": "inverse chips (notes button, pins)"
        },
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.accent}",
          "use": "text",
          "$description": "numerals on accent badges and the current pin"
        },
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.caution}",
          "use": "text",
          "$description": "ink labels on a caution fill"
        },
        {
          "fg": "{sys.color.ink}",
          "bg": "{sys.color.ok}",
          "use": "text",
          "$description": "ink labels on an ok fill"
        },
        {
          "fg": "{sys.color.ink-3}",
          "bg": "{sys.color.paper}",
          "use": "large-text",
          "$description": "labels of 24px or more, sources"
        },
        {
          "fg": "{sys.color.ink-3}",
          "bg": "{sys.color.tile}",
          "use": "large-text",
          "$description": "large labels on tiles"
        },
        {
          "fg": "{sys.color.ink-3}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "arrows and muted strokes"
        },
        {
          "fg": "{sys.color.accent}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "accent strokes, edges and arrows on the page"
        },
        {
          "fg": "{sys.color.accent}",
          "bg": "{sys.color.tile}",
          "use": "non-text",
          "$description": "accent strokes on tiles"
        },
        {
          "fg": "{sys.color.accent-ink}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "bold links, rings and node outlines"
        },
        {
          "fg": "{sys.color.alarm}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "the alarm status light"
        },
        {
          "fg": "{sys.color.alarm}",
          "bg": "{sys.color.tile}",
          "use": "non-text",
          "$description": "the alarm light on a tile"
        },
        {
          "fg": "{sys.color.loss}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "loss edges and badges"
        },
        {
          "fg": "{sys.color.ok}",
          "bg": "{sys.color.paper}",
          "use": "non-text",
          "$description": "ok strokes and status lights"
        },
        {
          "fg": "{sys.color.caution}",
          "bg": "{sys.color.paper}",
          "use": "decorative",
          "$description": "caution fills: never the only carrier of meaning, so no minimum; reported for the record"
        }
      ]
    }
  },
