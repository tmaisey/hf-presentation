  "sys": {
    "color": {
      "$type": "color",
      "paper": {
        "$value": "{ref.color.white.0}",
        "$description": "Page ground behind every slide: plain white; inverse text on ink chips. No texture or grain.",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "lt1"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "paper-deep": {
        "$value": "{ref.color.grey.100}",
        "$description": "Light-grey quiet fills, active pills and rules. A surface: never text, and too close to paper to carry meaning alone.",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "lt2"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      },
      "tile": {
        "$value": "{ref.color.white.0}",
        "$description": "Raised surface: diagram tiles, cards, menus and the inset highlight of every shadow. White on the white page, so the style's shadow does the lifting. A surface: never text.",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent6"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      },
      "ink": {
        "$value": "{ref.color.grey.900}",
        "$description": "Near-black titles and body text, and the tint of every shadow. Text-safe on every surface (16.0:1 on paper, 14.4:1 on paper-deep).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "dk1"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "ink-2": {
        "$value": "{ref.color.grey.700}",
        "$description": "Grey secondary text: subtitles, labels, the Insight label (6.0:1 on paper, 5.4:1 on paper-deep).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "dk2"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "ink-3": {
        "$value": "{ref.color.grey.500}",
        "$description": "Muted strokes, arrows and sources. As text only at 24px or larger (3.6:1 on paper: large text and non-text only, never body text).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent5"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "accent": {
        "$value": "{ref.color.blue.500}",
        "$description": "The bright blue lead: glows, fills, strokes, progress, bokeh. Fills/strokes only, never text (3.5:1 on paper: enough for strokes, not for text); ink numerals sit on it (4.5:1).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent1"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      },
      "accent-ink": {
        "$value": "{ref.color.blue.700}",
        "$description": "A darker shade of the accent blue for accent-coloured text: kickers, the current chapter, links (5.3:1 on paper, 4.8:1 on paper-deep). Use it wherever accent colour must be read.",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "hlink"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "loss": {
        "$value": "{ref.color.red.800}",
        "$description": "Deep red for sacrifice and irreversible loss, darker than the alarm red so the two never read as one. Sparingly; text-safe (6.9:1 on paper).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "folHlink"
            ]
          },
          "com.twm.palette": {
            "textSafe": true
          }
        }
      },
      "alarm": {
        "$value": "{ref.color.red.500}",
        "$description": "The bright red: a status light that something is down. Only for alarm lights and strokes, never text or large fills (3.9:1 on paper).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent2"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      },
      "caution": {
        "$value": "{ref.color.yellow.500}",
        "$description": "The bright yellow: caution fills and a chart series in PowerPoint (accent3). No component reads it yet. Never text and never a stroke on white (1.7:1 on paper): fills only, outlined or labelled in ink.",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent3"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      },
      "ok": {
        "$value": "{ref.color.green.500}",
        "$description": "The bright green: healthy or passing state, and a chart series in PowerPoint (accent4). No component reads it yet. Never text (3.0:1 on paper: strokes and fills only).",
        "$extensions": {
          "com.twm.pptx": {
            "slots": [
              "accent4"
            ]
          },
          "com.twm.palette": {
            "textSafe": false
          }
        }
      }
    }
  }
}
